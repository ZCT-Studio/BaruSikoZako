{
  "schemaVersion": 1,
  "id": "barusikozako",
  "version": "${productVersion}",
  "name": "BaruSikoZako",
  "authors": ["${authorsJson}"],
  "contact": {"homepage": "${homepageJson}", "sources": "${sourcesJson}", "issues": "${issuesJson}"},
  "icon": "icon.png",
  "description": "${descriptionJson}",
  "environment": "server",
  "entrypoints": {
    "server": ["io.github.zct_studio.barusikozako.fabric.FabricEntrypoint"]
  },
  "mixins": ["barusikozako.mixins.json"],
  "depends": {
    "fabricloader": "${loaderRequirement}",
    "minecraft": ["${minecraftVersions}"],
    "java": ">=25",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "license": "MPL-2.0"
}
