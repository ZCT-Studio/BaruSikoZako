{
  "schemaVersion": 1,
  "id": "barusikozako",
  "version": "${productVersion}",
  "name": "BaruSikoZako",
  "authors": ["${authorsJson}"],
  "contact": {"homepage": "${homepageJson}", "sources": "${sourcesJson}", "issues": "${issuesJson}"},
  "icon": "icon.png",
  "description": "${descriptionJson}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.zct_studio.barusikozako.fabric.FabricEntrypoint"]
  },
  "mixins": ["${mixinConfig}"],
  "breaks": {
    "barusikozako_api": "<${minimumApiVersion}"
  },
  "depends": {
    "fabricloader": "${loaderRequirement}",
    "minecraft": ["${minecraftVersions}"],
    "java": ">=${javaVersion}",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "license": "MPL-2.0"
}
