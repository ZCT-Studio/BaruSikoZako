      mixin: {
        injectors: true,
        mixins: [
          "EmptyServerCaptureMixin", "SavedDataObservation", "SavedDataQueue", "ServerSaveObservation",
          "PlayerFileObservation", "AuxiliaryPlayerObservation", "RootFileObservation",
          "ReplacementObservation", "ChunkUnloadObservation", "LevelEntityAccess", "EntityManagerAccess",
