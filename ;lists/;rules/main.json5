{
  groups: {
    source: {
      LegacyBase: ["main", "legacyJava"],
      ModernBase: ["main", "modernJava"],

      FabricLegacy: ["LegacyBase", "fabric", "fabricLegacy"],
      FabricModern: ["ModernBase", "fabric"],

      ForgeLegacy: ["LegacyBase", "forgeLegacy"],
      ForgeLegacy1201: ["ForgeLegacy", "forgeClassicBus", "forgeSrg"],
      ForgeLegacy1211: ["ForgeLegacy", "forgeClassicBus", "officialLegacy"],
      ForgeLegacyTyped: ["ForgeLegacy", "forgeTypedBus", "officialLegacy"],
      ForgeModern: ["ModernBase", "forgeModern"],

      NeoForgeLegacy: ["LegacyBase", "neoforge", "officialLegacy"],
      NeoForgeLegacy1211: ["NeoForgeLegacy", "neoforge1211"],
      NeoForgeModern: ["ModernBase", "neoforge"],
    },

    resource: {
      Fabric: ["main", "fabric"],
    },

    mixin: {
      Legacy1201: [
        "SavedDataObservation", "LegacyRegionWriteFailure", "LegacyChunkSerializationFailure",
        "LegacyPoiSerializationFailure", "PlayerFileObservation", "ClientLanguageObservation",
        "AuxiliaryPlayerObservation", "PlayerStatsObservation", "RootFileObservation",
        "ReplacementObservation", "ChunkUnloadObservation", "LevelEntityAccess", "EntityManagerAccess",
        "EntityStorageAccess", "LegacyPoiWrites", "PoiStorageAccess", "LegacyChunkStorageAccess",
      ],

      NeoForge1211: [
        "ServerSaveObservation", "PlayerFileObservation", "AuxiliaryPlayerObservation",
        "PlayerStatsObservation", "RootFileObservation", "ReplacementObservation",
        "ChunkUnloadObservation", "LevelEntityAccess", "EntityManagerAccess", "EntityStorageAccess",
        "LegacyPoiWrites", "PoiStorageAccess", "LegacyChunkStorageAccess",
      ],
      Legacy1211: ["SavedDataObservation", "NeoForge1211"],

      ModernHead: [
        "EmptyServerCaptureMixin", "SavedDataObservation", "SavedDataQueue", "ServerSaveObservation",
        "PlayerFileObservation", "AuxiliaryPlayerObservation",
      ],
      ModernTail: [
        "RootFileObservation", "ReplacementObservation", "ChunkUnloadObservation",
        "LevelEntityAccess", "EntityManagerAccess", "EntityStorageAccess", "PoiStorageAccess",
      ],
      Legacy12110: ["ModernHead", "PlayerStatsObservation", "ModernTail", "LegacyChunkStorageAccess"],

      Modern: ["ModernHead", "ModernTail"],
    },
  },

  rule: {
    "mc < 26": {
      mixin: { injectors: true },
    },
    "mc >= 26": {
      mixin: { groups: ["Modern"], injectors: false },
    },

    "mc == 1.20.1": {
      mixin: { groups: ["Legacy1201"] },
    },
    "mc == 1.21.1 && loader != 'neoforge'": {
      mixin: { groups: ["Legacy1211"] },
    },
    "mc == 1.21.10": {
      mixin: { groups: ["Legacy12110"] },
    },
    "mc == 1.21.11": {
      mixin: { groups: ["Modern"] },
    },

    "loader != 'fabric'": {
      resource: ["main"],
    },

    "loader == 'fabric' && mc < 26": {
      source: ["FabricLegacy"],
      resource: ["Fabric"],
    },
    "loader == 'fabric' && mc >= 26": {
      source: ["FabricModern"],
      resource: ["Fabric"],
    },

    "loader == 'forge' && mc == 1.20.1": {
      source: ["ForgeLegacy1201"],
      mixin: { refmap: true },
    },
    "loader == 'forge' && mc == 1.21.1": {
      source: ["ForgeLegacy1211"],
    },
    "loader == 'forge' && (mc == 1.21.10 || mc == 1.21.11)": {
      source: ["ForgeLegacyTyped"],
    },
    "loader == 'forge' && mc >= 26": {
      source: ["ForgeModern"],
    },

    "loader == 'neoforge' && mc == 1.21.1": {
      source: ["NeoForgeLegacy1211"],
      mixin: {
        groups: ["NeoForge1211"],
        plugin: "io.github.zct_studio.barusikozako.NeoForgeSavedDataMixins",
      },
    },
    "loader == 'neoforge' && (mc == 1.21.10 || mc == 1.21.11)": {
      source: ["NeoForgeLegacy"],
    },
    "loader == 'neoforge' && mc >= 26": {
      source: ["NeoForgeModern"],
    },
  },
}
