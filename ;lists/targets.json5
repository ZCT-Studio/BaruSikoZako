{
  rules: [
    "main.json5",
  ],

  // 合并发布（一个 jar 同时支持多 Loader）的 Minecraft 版本。
  // 这些目标的 Mixin 配置按 Loader 区分文件名，避免合并后的 jar 中同名资源冲突。
  // LTS 版本不在此列，继续保持每个 Loader 单独分发。
  merge: [
    "1.21.10",
    "1.21.11",
    "26.1.2",
    "26.2",
    "26.3",
  ],

  jdk: {
    "fabric@26.1.2": 25,
    "fabric@26.2": 25,
    "fabric@26.3": 25,
    "neoforge@26.1.2": 25,
    "neoforge@26.2": 25,
    "neoforge@26.3": 25,
    "forge@26.1.2": 25,
    "forge@26.2": 25,
    "forge@26.3": 25,

    "forge@1.21.1": 21,
    "forge@1.21.10": 21,
    "forge@1.21.11": 21,
    "fabric@1.21.10": 21,
    "fabric@1.21.11": 21,
    "neoforge@1.21.10": 21,
    "neoforge@1.21.11": 21,

    "forge@1.20.1": 17,
    "fabric@1.20.1": 17,
    "fabric@1.21.1": 21,
    "neoforge@1.21.1": 21,
  },

  // 可选的单个目标显式覆盖，优先级最高。键必须已在上面的 jdk 中注册
  // 字段与规则文件一致（source / resource / mixin）。
  // targets: {
  //   "fabric@26.3": { mixin: { refmap: true } },
  // },
}
